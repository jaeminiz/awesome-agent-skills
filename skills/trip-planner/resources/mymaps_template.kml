<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>여행 일정 - 구글 내 지도 (My Maps)</name>
    <description>일자별 레이어, 번호 마커 및 이동 동선이 포함된 올인원 KML</description>

    <!-- 일자별 경로 선 스타일 (KML 색상 코드는 aabbggrr 포맷) -->
    <!-- Day 1: 주황색 테마 (ff0088ff) -->
    <Style id="route-day-1">
      <LineStyle>
        <color>ff147efa</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- Day 2: 파란색 테마 (ffff8833) -->
    <Style id="route-day-2">
      <LineStyle>
        <color>ffff8833</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- Day 3: 초록색 테마 (ff44c022) -->
    <Style id="route-day-3">
      <LineStyle>
        <color>ff44c022</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- Day 4: 보라색 테마 (ffa033aa) -->
    <Style id="route-day-4">
      <LineStyle>
        <color>ffa033aa</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- 1일차 레이어 (Folder) -->
    <Folder>
      <name>1일차</name>

      <!-- 1번 장소 핀 -->
      <Placemark>
        <name>1. 다낭 국제공항(DAD) 도착 및 입국</name>
        <description><![CDATA[
          <b>날짜:</b> 2026-10-23<br>
          <b>시간:</b> 07:00-11:30<br>
          <b>설명:</b> LCC 직항 탑승 및 다낭 입국심사, 위탁 수하물 수령 후 입국장 이동.<br>
          <b>이동/메모:</b> 공항 픽업 차량 또는 그랩 7인승 탑승 (호텔까지 약 15분 소요)<br>
          <a href="https://www.google.com/maps/search/?api=1&query=Da%20Nang%20International%20Airport">구글 지도에서 열기</a>
        ]]></description>
        <Point>
          <!-- 경도(longitude), 위도(latitude), 고도(altitude) 순서 -->
          <coordinates>108.2022,16.0539,0</coordinates>
        </Point>
      </Placemark>

      <!-- 2번 장소 핀 -->
      <Placemark>
        <name>2. 살라 다낭 비치 호텔 (짐 보관)</name>
        <description><![CDATA[
          <b>날짜:</b> 2026-10-23<br>
          <b>시간:</b> 11:30-12:30<br>
          <b>설명:</b> 호텔 프론트 데스크에 캐리어 사전 보관 접수 및 환복.<br>
          <b>이동/메모:</b> 직원에게 바우처 제시 후 짐 보관 태그 수령. 도보 또는 그랩으로 포홍 이동<br>
          <a href="https://www.google.com/maps/search/?api=1&query=Sala%20Danang%20Beach%20Hotel">구글 지도에서 열기</a>
        ]]></description>
        <Point>
          <coordinates>108.2464,16.0641,0</coordinates>
        </Point>
      </Placemark>

      <!-- 1일차 이동 경로 선 -->
      <Placemark>
        <name>1일차 이동 경로</name>
        <styleUrl>#route-day-1</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            108.2022,16.0539,0
            108.2464,16.0641,0
          </coordinates>
        </LineString>
      </Placemark>
    </Folder>

  </Document>
</kml>
